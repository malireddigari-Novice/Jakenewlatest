# Jakenew — MAG-7 Attention Engine. Copy to .env and fill in your values.

# ── Charles Schwab (OI / structural context; optional) ───────────────────────
# Register a developer app at developer.schwab.com; callback URL https://127.0.0.1
SCHWAB_ENABLED=true
SCHWAB_API_KEY=your_schwab_client_id_here
SCHWAB_APP_SECRET=your_schwab_client_secret_here
SCHWAB_CALLBACK_URL=https://127.0.0.1
SCHWAB_TOKEN_FILE=schwab_token.json

# ── Alpaca (intraday data + execution) ───────────────────────────────────────
# From alpaca.markets → API keys.
ALPACA_API_KEY=your_alpaca_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_here
ALPACA_PAPER=true          # true = paper, false = live money
ALPACA_ENABLED=false       # true = auto-execute; keep false until you've watched it run
TRADE_PCT=0.01             # fraction of portfolio value per convexity trade
MAX_OPEN_POSITIONS=1       # single-trade discipline: hold the day's attention leader

# ── Notifications (optional) ─────────────────────────────────────────────────
DISCORD_WEBHOOK_URL=
DISCORD_USERNAME=Mag 7 Algo        # name every post goes out under
LEGACY_DISCORD_ENABLED=false       # legacy attention-engine cards stay in the log (members see campaign-flow only)

# ── Campaign-flow member cards + Mag 7 brief controls (campaign_flow/settings.py) ──
CF_PUBLISH_PROPOSED=false          # only FILLED cards post; proposals stay in the journal
CF_CARD_SHOW_RETURN=false          # simulated % return kept off member cards pending attorney review
CF_CARD_SHOW_CAMPAIGN_ID=false
CF_MAX_ENTRIES_PER_RIGHT_DAY=1     # one call + one put entry per day (0 = off)
CF_ENTRY_CAP_SCOPE=ALL             # ALL = across the Mag 7, TICKER = per name
CF_CONV_ENABLED=true               # entries need CONFIRMED conviction; exits need more (CF_EXIT_CONV_HYSTERESIS)
CF_MIN_HOLD_S=900                  # no opposite-cluster rotation exit before this
CF_TRAIL_ARM_GAIN=1.00             # trailing stop arms at +100% (0 = off) ...
CF_TRAIL_GIVEBACK=0.60             # ... and exits after giving back 60% of the peak gain
CF_OVERNIGHT_ENABLED=true          # carry next-expiration positioning overnight on a consolidated day
CF_OVERNIGHT_MAX_PREMIUM=600       # $ premium carried overnight, all positions

# ── Mag 7 Algo alerts Google Sheet (campaign_flow/alerts_sheet.py) ──
# Share the sheet with the service account's email (Editor). Uses GOOGLE_SERVICE_ACCOUNT_FILE.
ALERTS_SHEET_ENABLED=false
ALERTS_SPREADSHEET_ID=
ALERTS_SHEET_TAB=Alerts
ALERTS_SHEET_FROM=2026-11-03       # first session written (New York date)

# ── Attention Engine tuning (defaults shown) ─────────────────────────────────
ATTENTION_ENABLED=true
ATTENTION_SCORE_MIN=70
ATTENTION_MIN_TOTAL=250000
ATTENTION_W_SHARE=0.40
ATTENTION_W_VELOCITY=0.25
ATTENTION_W_ACCELERATION=0.15
ATTENTION_W_CONTROL=0.10
ATTENTION_W_LOW=0.10
ATTENTION_GATE_ENABLED=true
ATTENTION_GATE_MAX_RANK=2
ATTENTION_SINGLE_TRADE=true
ATTENTION_EXIT_ENABLED=true
ATTENTION_EXIT_ROTATE_RANK=2
ATTENTION_EXIT_SUSTAIN=3
POLL_INTERVAL_SECONDS=60
ENTRY_ATM_MAX_STEPS=1       # buy ATM, or the very next strike if ATM is unquotable
